<Window
    x:Class="KneeboardApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#10151C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="24,18,24,14" Spacing="10">
            <TextBlock Text="&#9992;" FontSize="24" Foreground="#F2B134" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="PILOT KNEEBOARD" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="#F2B134"/>
                <TextBlock Text="Quick Reference Card" FontFamily="Consolas" FontSize="12" Foreground="#8A94A3"/>
            </StackPanel>
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="1" Padding="24,0,24,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Info Panel -->
            <Border Grid.Column="0" Background="#1C232C" CornerRadius="10" Padding="18"
                    BorderBrush="#2E3742" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">

                        <TextBlock Text="FLIGHT INFO" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#8A94A3"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="CALLSIGN" FontFamily="Consolas" FontSize="11" Foreground="#6F7A88"/>
                            <TextBox x:ConnectionId='15' x:Name="CallsignBox" PlaceholderText="e.g. SPEEDBIRD 23"
                                     FontFamily="Consolas" CharacterCasing="Upper"/>
                        </StackPanel>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="DEPARTURE APT" FontFamily="Consolas" FontSize="11" Foreground="#6F7A88"/>
                                <TextBox x:ConnectionId='14' x:Name="DepartureAirportBox" PlaceholderText="ICAO"
                                         FontFamily="Consolas" CharacterCasing="Upper" MaxLength="4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="ARRIVAL APT" FontFamily="Consolas" FontSize="11" Foreground="#6F7A88"/>
                                <TextBox x:ConnectionId='13' x:Name="ArrivalAirportBox" PlaceholderText="ICAO"
                                         FontFamily="Consolas" CharacterCasing="Upper" MaxLength="4"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="DEPARTURE PROCEDURE (SID)" FontFamily="Consolas" FontSize="11" Foreground="#6F7A88"/>
                            <TextBox x:ConnectionId='12' x:Name="SidBox" PlaceholderText="e.g. DEEZZ5" FontFamily="Consolas" CharacterCasing="Upper"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="ARRIVAL PROCEDURE (STAR)" FontFamily="Consolas" FontSize="11" Foreground="#6F7A88"/>
                            <TextBox x:ConnectionId='11' x:Name="StarBox" PlaceholderText="e.g. ANJLL2" FontFamily="Consolas" CharacterCasing="Upper"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="SQUAWK CODE" FontFamily="Consolas" FontSize="11" Foreground="#6F7A88"/>
                            <TextBox x:ConnectionId='9' x:Name="SquawkBox" PlaceholderText="e.g. 4721"
                                     FontFamily="Consolas" MaxLength="4"                                />
                            <TextBlock x:ConnectionId='10' x:Name="SquawkError" Text="Squawk must be 4 digits, each 0-7"
                                       FontFamily="Consolas" FontSize="10" Foreground="#E5533D" Visibility="Collapsed"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="SELCAL CODE" FontFamily="Consolas" FontSize="11" Foreground="#6F7A88"/>
                            <TextBox x:ConnectionId='7' x:Name="SelcalBox" PlaceholderText="e.g. AB-CD"
                                     FontFamily="Consolas" CharacterCasing="Upper" MaxLength="5"                                />
                            <TextBlock x:ConnectionId='8' x:Name="SelcalError" Text="SELCAL format: 4 letters, e.g. AB-CD"
                                       FontFamily="Consolas" FontSize="10" Foreground="#E5533D" Visibility="Collapsed"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Notes Panel -->
            <Border Grid.Column="1" Background="#1C232C" CornerRadius="10" Padding="18"
                    BorderBrush="#2E3742" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="NOTES / ATIS / CLEARANCE" FontFamily="Consolas" FontSize="13"
                               FontWeight="Bold" Foreground="#8A94A3" Margin="0,0,0,10"/>
                    <TextBox x:ConnectionId='6' Grid.Row="1" x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="14" Foreground="#DCE3EA"
                             Background="Transparent" BorderThickness="0"
                             PlaceholderText="Jot down ATIS letter, clearance, runway, frequencies, hold instructions..."
                             VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Padding="24,10,24,18" Spacing="10">
            <Button x:ConnectionId='2' x:Name="NewButton" Content="New"                        />
            <Button x:ConnectionId='3' x:Name="LoadButton" Content="Load..."                         />
            <Button x:ConnectionId='4' x:Name="SaveButton" Content="Save..."                          Style="{StaticResource AccentButtonStyle}"/>
            <TextBlock x:ConnectionId='5' x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                       FontFamily="Consolas" FontSize="12" Foreground="#8A94A3"/>
        </StackPanel>
    </Grid>
</Window>

